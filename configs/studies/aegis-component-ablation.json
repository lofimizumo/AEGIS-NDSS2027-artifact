      "gpt2"
    ],
    "datasets": [
      "wikitext2"
    ],
    "attacks": [
      "dager",
      "mlp_svd",
      "embed_norm"
    ],
    "variants": [
      "a0",
      "a1",
      "a2",
      "a3",
      "a4",
      "a5",
      "a6",
      "a7"
    ],
    "epochs": 20,
    "lr": 5e-05,
    "batch_size": 8,
    "dataset_size": 1000,
    "n_attack": 10,
    "early_stop_patience": 5
  },
  "quick_defaults": {
    "epochs": 1,
    "batch_size": 4,
    "dataset_size": 20,
    "n_attack": 3,
    "early_stop_patience": 0
  },
  "validation_defaults": {
    "variants": [
      "a0",
      "a4",
      "a7"
    ]
  },
  "output_filename": "aegis-component-ablation.json",
  "behavior": {
    "validation_strategy": "ablation",
    "validation_attack": "dager",
    "validation_open_variant": "a0",

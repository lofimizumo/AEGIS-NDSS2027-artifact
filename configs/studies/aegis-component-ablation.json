{
  "name": "aegis-component-ablation",
  "title": "AEGIS component ablation",
  "mode": "ablation",
  "models": [
    "tiny_gpt2",
    "gpt2",
    "gpt2-medium",
    "gpt2-large",
    "gpt2-xl",
    "bert-base",
    "bert-large",
    "roberta-base",
    "roberta-large",
    "deberta-v3-small",
    "deberta-v3-base",
    "deberta-v3-large",
    "llama-2-7b",
    "llama-2-13b",
    "llama-3.1-8b",
    "gemma-2-2b",
    "gemma-2-9b",
    "phi-2",
    "opt-1.3b"
  ],
  "datasets": [
    "rotten_tomatoes",
    "emotion",
    "financial_phrasebank",
    "wikitext2",
    "dialogsum",
    "cnn_dailymail"
  ],
  "defenses": [
    "none",
    "aegis"
  ],
  "attacks": [
    "dager",
    "mlp_svd",
    "embed_norm"
